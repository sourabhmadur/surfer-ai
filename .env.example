# Copy to .env (repo root or backend/) and fill in the key for the provider you use.
# Provider: google (default) | openai | anthropic
MODEL_PROVIDER=google

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the model names defaulted in backend/src/config.py.
# The defaults (gemini-pro-vision, gpt-4-vision-preview, claude-3-opus) are
# legacy model IDs; set a current vision-capable model here.
# GEMINI_MODEL=
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
